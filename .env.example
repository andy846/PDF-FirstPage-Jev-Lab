# Required only when --backend jev is explicitly chosen.
# Never commit real keys or real customer document text.
TYPESAFE_API_KEY=
# Optional pinned model version used for text-only classification
JEV_MODEL=jev-1.13.0

# Alternative host: OpenCode Console serves the same System One model at
# https://opencode.ai/inference/systemone/v1/systemone with an OpenCode
# Console service key (oc_sk_...). jev-1.13-free is free while available.
# OPENCODE_API_KEY=oc_sk_...
# JEV_ENDPOINT=https://opencode.ai/inference/systemone/v1/systemone
# JEV_MODEL=jev-1.13-free

# OpenRouter backend (--backend openrouter): TypeSafe Jev System One decisions
# (typesafe/jev-1.14 by default) through OpenRouter's alpha decisions endpoint.
# Requires explicit --allow-external-text.
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=typesafe/jev-1.14
# OPENROUTER_ENDPOINT=https://openrouter.ai/api/alpha/decisions
